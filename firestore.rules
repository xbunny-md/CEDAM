rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'jkambi00@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'badges', 'followersCount', 'followingCount', 'postsCount', 'likesReceived', 'challengesJoined', 'challengeVotesReceived'])) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'badges', 'followersCount', 'followingCount', 'postsCount', 'likesReceived', 'challengesJoined', 'challengeVotesReceived']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points']) || 
            (request.resource.data.points >= (resource.data.points != null ? resource.data.points : 0) && request.resource.data.points - (resource.data.points != null ? resource.data.points : 0) <= 50)
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['badges']) || request.auth.uid == userId
          )
        )
      );
      allow delete: if isAdmin();
      
      match /saves/{postId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == followerId || isAdmin());
      }
      match /following/{followingId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && (request.resource.data.actorId == request.auth.uid || isAdmin());
        allow update: if request.auth != null && ((request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])) || isAdmin());
      }
    }
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (resource.data.authorId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes', 'pollOptions']) || isAdmin());
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
      
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /votes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow update, delete: if isAdmin();
      }
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null || isAdmin();
      allow update: if request.auth != null && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantsCount', 'status']) || isAdmin());
      allow delete: if request.auth != null && (resource.data.creatorId == request.auth.uid || isAdmin());
      
      match /participants/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      match /entries/{entryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update: if request.auth != null && (resource.data.authorId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesCount']) || isAdmin());
        allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
        
        match /votes/{userId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
          allow update, delete: if isAdmin();
        }
      }
    }
    match /reports/{reportId} {
      allow create: if request.auth != null && (request.resource.data.reporterId == request.auth.uid || isAdmin());
      allow read, update, delete: if isAdmin();
    }
  }
}
